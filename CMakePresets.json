{
  "version": 5,
  "configurePresets": [
    {
      "name": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "ci-clang-sanitizers",
      "displayName": "Clang ASan + UBSan + -Werror (mirrors ubuntu-clang-sanitizers.yml)",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build-sanitizers",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "BUILD_TOOLS": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g -Werror -D_GLIBCXX_ASSERTIONS",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-clang-sanitizers",
      "configurePreset": "ci-clang-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "ci-clang-sanitizers",
      "displayName": "Unit + end-to-end tests under ASan/UBSan (mirrors CI)",
      "configurePreset": "ci-clang-sanitizers",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=1:detect_leaks=0:strict_string_checks=1:check_initialization_order=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "filter": {
        "include": { "label": "unit|end-to-end" },
        "exclude": {
          "name": "^(tests-binding_constraints|tests-modeler|tests-simple-study|test-api|timeseries-tests|test-unfeasible-problem-analyzer|unit-tests-for-solver-optimisation|unit-tests-for-component-filler|tests-solver-utils|test-expressions|unit-tests-for-modeler-api|testOutputs)$"
        }
      }
    }
  ]
}
