      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_PREFIX_PATH": "/tmp/deps/ortools_9.12-rte1.1_cxx_ubuntu-22.04_static_sirius/install;/tmp/deps/sirius",
        "BUILD_ORTOOLS": "OFF",
        "BUILD_UI": "OFF",
